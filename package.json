{
  "name": "ashi",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "app": "bash ./scripts/start-app.sh",
    "app:dev": "bash ./scripts/start-app.sh --dev",
    "app:screenshot": "bash ./scripts/start-app.sh --screenshot",
    "android": "react-native run-android",
    "android:demo:build": "cd android && ./gradlew assembleRelease",
    "android:demo:share": "bash ./scripts/share-apk-link.sh",
    "android:demo:share:local": "SHARE_MODE=local bash ./scripts/share-apk-link.sh",
    "android:demo:share:tunnel": "SHARE_MODE=tunnel bash ./scripts/share-apk-link.sh",
    "backend:build": "npm --prefix stepalign-backend run build",
    "backend:start": "npm --prefix stepalign-backend run start",
    "backend:start:dev": "npm --prefix stepalign-backend run start:dev",
    "dev:all": "bash ./scripts/start-dev-macos.sh",
    "dev:all:dry-run": "bash ./scripts/start-dev-macos.sh --dry-run",
    "dev:tunnel": "bash ./scripts/start-tunnel.sh",
    "dev:tunnel:localhostrun": "TUNNEL_PROVIDER=localhostrun bash ./scripts/start-tunnel.sh",
    "dev:tunnel:localtunnel": "TUNNEL_PROVIDER=localtunnel bash ./scripts/start-tunnel.sh",
    "esp32:compile": "bash ./scripts/flash-esp32.sh compile",
    "esp32:flash": "bash ./scripts/flash-esp32.sh flash",
    "esp32:monitor": "bash ./scripts/flash-esp32.sh monitor",
    "ios": "react-native run-ios",
    "lint": "eslint .",
    "start": "react-native start",
    "test": "jest"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^1.23.1",
    "react": "18.2.0",
    "react-native": "0.73.8",
    "react-native-base64": "^0.2.2",
    "react-native-ble-plx": "^3.5.1",
    "react-native-draggable-flatlist": "^4.0.3",
    "react-native-gesture-handler": "^2.14.0",
    "react-native-linear-gradient": "^2.8.3",
    "react-native-reanimated": "^3.10.1",
    "react-native-svg": "^13.14.0",
    "victory-native": "^36.6.8",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@babel/preset-env": "^7.20.0",
    "@babel/runtime": "^7.20.0",
    "@react-native/babel-preset": "0.73.21",
    "@react-native/eslint-config": "0.73.2",
    "@react-native/metro-config": "0.73.5",
    "@react-native/typescript-config": "0.73.1",
    "@types/react": "^18.2.6",
    "@types/react-test-renderer": "^18.0.0",
    "babel-jest": "^29.6.3",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react-test-renderer": "18.2.0",
    "typescript": "5.0.4"
  },
  "engines": {
    "node": ">=18"
  }
}
