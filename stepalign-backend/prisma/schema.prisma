// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id @default(uuid())
  email     String?  @unique
  createdAt DateTime @default(now())

  sessions  Session[]
}

model Session {
  id               String   @id @default(uuid())
  userId           String
  clientId         String?
  startedAt        DateTime
  duration         Int

  stabilityAvg     Float
  inwardRatio      Float
  balanceScore     Float

  motorActivations Int      @default(0)
  outwardEvents    Int      @default(0)
  avgCorrectionMs  Int      @default(0)
  peakAngle        Float    @default(0)
  avgAngle         Float    @default(0)
  inwardThreshold  Int      @default(8)
  outwardThreshold Int?
  steps            Int?
  cadence          Int?
  source           String   @default("ble")
  trace            Float[]  @default([])

  createdAt        DateTime @default(now())
  updatedAt        DateTime @default(now()) @updatedAt

  samples          Sample[]

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, clientId])
  @@index([userId, startedAt])
}

model Sample {
  id        String   @id @default(uuid())
  sessionId String
  timestamp DateTime

  roll      Float
  stability Float
  inward    Float

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}
